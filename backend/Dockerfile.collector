FROM eclipse-temurin:17-jdk-jammy AS build
WORKDIR /workspace
COPY gradlew build.gradle settings.gradle ./
COPY gradle ./gradle
COPY src ./src
RUN sed -i 's/\r$//' gradlew
RUN --mount=type=cache,target=/root/.gradle sh ./gradlew --no-daemon --max-workers=2 collectorDist

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
COPY --from=build /workspace/build/collector/ ./
USER 10001:10001
ENTRYPOINT ["java", "-Xms32m", "-Xmx256m", "-cp", "/app/classes:/app/lib/*", "com.pickdeal.collector.remote.LocalCollectorMain"]
