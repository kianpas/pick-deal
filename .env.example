# Copy to .env and set a password before running Docker Compose.
DB_NAME=pickdeal
DB_USERNAME=pickdeal
DB_PASSWORD=
BACKEND_PORT=8080
# Enable only on the single intended collector host after checking the deployment.
COLLECTOR_ENABLED=false
JAVA_TOOL_OPTIONS='-Xms128m -Xmx768m -XX:+ExitOnOutOfMemoryError'
